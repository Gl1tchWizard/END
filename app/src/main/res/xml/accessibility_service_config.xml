<?xml version="1.0" encoding="utf-8"?>
<!--
  canRetrieveWindowContent is needed for two things: reading the browser
  address bar, and finding the scrollable node to push the feed back with when
  it is driven past the end. END never reads page text or content.

  notificationTimeout is 0 on purpose: a burst of content changes is how END
  counts feeds that never report scrolling, and a timeout would coalesce it
  into nothing. The handler is cheap, so the flood costs little.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewScrolled|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0"
    android:description="@string/accessibility_description"
    android:settingsActivity="app.willswitch.end.MainActivity" />
